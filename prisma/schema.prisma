generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- UTILISATEURS ---
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      String
  phone     String? 
  avatar    String?  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime?

  createdRequisitions Requisition[]
  sales               Sale[]
  exchangeRates       ExchangeRate[]
  cashMovements       CashMovement[]
  cashSessions        CashSession[]
  auditLogs           AuditLog[]
  validatedPrescriptions PrescriptionRegister[]
  stockAuditsCreated  StockAudit[] @relation("AuditCreator")
  stockAuditsCompleted StockAudit[] @relation("AuditCompleter")
  stockWriteOffs      StockWriteOff[]
}

// --- GESTION DE STOCK ---
model Supplier {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())

  requisitions Requisition[]
}

model Product {
  id                     String  @id @default(uuid())
  name                   String
  dci                    String?
  code                   String  @unique
  codeCip7               String?
  codeAtc                String?
  category               String  @default("Générique")
  form                   String?
  dosage                 String?
  packaging              String?
  description            String?
  isPrescriptionRequired Boolean @default(false)
  isNarcotic             Boolean @default(false)
  narcoticSchedule       String? // TABLE_A | TABLE_B | NARCOTIC

  minStock     Int     @default(5)
  maxStock     Int?
  currentStock Int     @default(0)
  location     String?

  sellPrice   Float
  buyingPrice Float @default(0)
  vatRate     Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots             StockLot[]
  requisitionItems RequisitionItem[]
  saleItems        SaleItem[]
  prescriptionRegisters PrescriptionRegister[]
  stockAuditItems  StockAuditItem[]
  writeOffs        StockWriteOff[]
}

model StockLot {
  id           String   @id @default(uuid())
  batchNumber  String
  expiryDate   DateTime
  quantity     Int
  receivedDate DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  saleItems SaleItem[]
  stockAuditItems StockAuditItem[]
  writeOffs   StockWriteOff[]

  @@index([expiryDate])
  @@index([productId, expiryDate])
}

model Requisition {
  id        String   @id @default(uuid())
  reference String   @unique
  status    String   @default("DRAFT")
  date      DateTime @default(now())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  items RequisitionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RequisitionItem {
  id            String      @id @default(uuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Int
  buyPrice      Float
  batchNumber   String?
  expiryDate    DateTime?
}

// --- CRM ---
model Client {
  id      String  @id @default(uuid())
  code    String  @unique // ex: PAT-001
  name    String
  phone   String?
  email   String?
  address String?

  // Nouveaux champs pour la gestion pro
  creditLimit    Float  @default(0)
  currentCredit  Float  @default(0)
  loyaltyStatus  String @default("NONE") // NONE, BRONZE, SILVER, GOLD
  totalPurchases Int    @default(0)

  insuranceProvider String?
  insuranceNumber   String?

  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- VENTES & POS ---
model Sale {
  id             String   @id @default(uuid())
  reference      String   @unique
  subTotal       Float
  taxAmount      Float    @default(0)
  discountAmount Float    @default(0)
  totalAmount    Float
  paymentMethod  String
  status         String   @default("COMPLETED")
  date           DateTime @default(now())

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  items SaleItem[]

  currency     String @default("CDF") // CDF ou USD
  exchangeRate Float  @default(1) // Taux utilisé lors de la vente (pour figer la valeur)

  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])

  prescriptions PrescriptionRegister[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cashSessionId])
}

model SaleItem {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  stockLotId String?
  stockLot   StockLot? @relation(fields: [stockLotId], references: [id])

  quantity  Int
  unitPrice Float
  costPrice Float
  taxRate   Float @default(0)
  total     Float
}

// Taux de change (Historique)
model ExchangeRate {
  id      String   @id @default(uuid())
  rate    Float // 1 USD = X CDF
  date    DateTime @default(now())
  setById String
  setBy   User     @relation(fields: [setById], references: [id])
}

// --- FINANCE & CAISSE ---
model CashMovement {
  id          String   @id @default(uuid())
  type        String // IN, OUT
  category    String // SALES, DEBT_PAYMENT, etc.
  amount      Float
  description String?
  date        DateTime @default(now())

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- SESSION DE CAISSE (Z DE CAISSE) ---
model CashSession {
  id        String    @id @default(uuid())
  status    String    @default("OPEN") // OPEN | CLOSED
  openedAt  DateTime  @default(now())
  closedAt  DateTime?

  cashierId String
  cashier   User   @relation(fields: [cashierId], references: [id])

  exchangeRate Float @default(1)

  initialUsdCents Int @default(0)
  initialCdfCents Int @default(0)

  systemUsdCents      Int?
  systemCdfCents      Int?
  declaredUsdCents    Int?
  declaredCdfCents    Int?
  discrepancyUsdCents Int?
  discrepancyCdfCents Int?

  sales              Sale[]
  denominationCounts CashDenominationCount[]
  auditLogs          AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cashierId])
  @@index([status])
  @@index([openedAt])
}

model CashDenominationCount {
  id           String      @id @default(uuid())
  sessionId    String
  session      CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  currency     String // USD | CDF
  denomination Int
  quantity     Int
  totalMinor   Int // Montant en unités mineures (centimes USD, francs CDF)

  @@unique([sessionId, currency, denomination])
  @@index([sessionId])
}

// --- AUDIT PERSISTÉ ---
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  details   String?
  metadata  String?
  sessionId String?
  session   CashSession? @relation(fields: [sessionId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// --- PARAMÈTRES LOCAUX (IMPRESSION) ---
model AppSettings {
  id              String  @id @default("default")
  defaultPrinter  String?
  receiptWidth    String  @default("80") // 58 | 80
  pharmacyName    String  @default("Pharmacie Maria")
  pharmacyAddress String?
  pharmacyPhone   String?
  pharmacyRccm    String?
  pharmacyIdNat   String?
  updatedAt       DateTime @updatedAt
}

// --- ORDONNANCIER NUMÉRIQUE ---
model PrescriptionRegister {
  id          String @id @default(uuid())
  orderNumber String @unique

  saleId    String?
  sale      Sale?   @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  prescriberName          String
  prescriberQualification String
  prescriberLicense       String?

  patientName       String
  patientAge        Int?
  patientIdDocument String?

  prescriptionDate  DateTime
  dispensedDate     DateTime @default(now())
  quantityDispensed Int

  validatedById String
  validatedBy   User   @relation(fields: [validatedById], references: [id])

  createdAt DateTime @default(now())

  @@index([dispensedDate])
  @@index([productId])
  @@index([orderNumber])
}

// --- INVENTAIRE TOURNANT ---
model StockAudit {
  id          String @id @default(uuid())
  reference   String @unique
  status      String @default("DRAFT")
  exchangeRate Float @default(1)

  createdById   String
  createdBy     User   @relation("AuditCreator", fields: [createdById], references: [id])
  completedById String?
  completedBy   User?  @relation("AuditCompleter", fields: [completedById], references: [id])

  items StockAuditItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

model StockAuditItem {
  id      String     @id @default(uuid())
  auditId String
  audit   StockAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  stockLotId String?
  stockLot   StockLot? @relation(fields: [stockLotId], references: [id])

  expectedQuantity Int
  countedQuantity  Int
  discrepancy      Int

  unitCostUsd  Float
  unitCostCdf  Float
  lossValueUsd Float @default(0)
  lossValueCdf Float @default(0)

  @@index([auditId])
  @@index([productId])
}

// --- DÉCLASSEMENT / SORTIE PÉREMPTION ---
model StockWriteOff {
  id         String   @id @default(uuid())
  stockLotId String
  stockLot   StockLot @relation(fields: [stockLotId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  quantity Int
  reason   String
  notes    String?

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([stockLotId])
  @@index([createdAt])
}
